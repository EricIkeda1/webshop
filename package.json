{
  "name": "eyi-store-react",
  "private": true,
  "version": "2.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "node server/index.mjs",
    "typecheck": "tsc -b",
    "format": "prettier --write src server api scripts index.html vite.config.ts tsconfig.json package.json README.md",
    "test": "node scripts/test-feed.mjs && node scripts/test-address.mjs && node scripts/test-server.mjs && node scripts/test-vercel.mjs && node scripts/test-images.mjs && node scripts/test-carousel.mjs",
    "start": "node server/index.mjs",
    "sync:images": "node scripts/sync-product-images.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.10"
  },
  "engines": {
    "node": "22.x"
  }
}
